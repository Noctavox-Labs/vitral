    "Solo %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only %@"
          }
        }
      }
    },
    "Suficiente para la mayoría de los programas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enough for most programs."
