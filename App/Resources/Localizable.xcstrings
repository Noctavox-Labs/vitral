      }
    },
    "Wine de CrossOver, compilado por el proyecto Sikarugir. Se descarga de GitHub y se comprueba con SHA-256 antes de usarlo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CrossOver's Wine, built by the Sikarugir project. It's downloaded from GitHub and checked with SHA-256 before use."
          }
