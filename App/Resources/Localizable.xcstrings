          }
        }
      }
    },
    "Traduce el código de los programas de Windows para tu chip." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translates the code of Windows programs for your chip."
          }
        }
      }
    },
    "Traduce el código de los programas de Windows para tu chip. macOS te pedirá tu contraseña." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translates the code of Windows programs for your chip. macOS will ask for your password."
          }
        }
      }
    },
