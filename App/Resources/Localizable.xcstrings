      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Windows apps"
          }
        }
      }
    },
    "Ver qué necesita tu Mac para abrir programas de Windows" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what your Mac needs to open Windows programs"
          }
        }
