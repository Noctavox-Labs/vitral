      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a library (DLL), not a program: it doesn't open on its own."
          }
        }
      }
    },
    "Eso no parece un instalador de Windows. Vitral abre archivos .exe, .msi y .zip." : {
      "localizations" : {
