+
+/* Like Internet Explorer (and the HTML standard), a name shared by several elements gives a
+ * collection of all of them, and calling it, as in name(i), gives its i-th element or null.
+ * Encarta 2009 walks its section headers, all with id "SecHeader", with SecHeader(i) until it
+ * gets null; with the first element every time, its articles hung. Returns NULL for a single
+ * element, which keeps the getElementById path below. */
+static IHTMLElementCollection *get_elements_by_global_name(HTMLInnerWindow *window, const WCHAR *name)
+{
+    IHTMLElementCollection *all, *col = NULL;
+    VARIANT name_var, index;
+    IDispatch *disp;
+    HRESULT hres;
+
+    if(!window->doc)
+        return NULL;
+    hres = IHTMLDocument2_get_all(&window->doc->IHTMLDocument2_iface, &all);
+    if(FAILED(hres) || !all)
+        return NULL;
 
+    V_VT(&name_var) = VT_BSTR;
+    V_BSTR(&name_var) = SysAllocString(name);
+    V_VT(&index) = VT_EMPTY;
+    hres = IHTMLElementCollection_item(all, name_var, index, &disp);
+    SysFreeString(V_BSTR(&name_var));
+    IHTMLElementCollection_Release(all);
+    if(FAILED(hres) || !disp)
+        return NULL;
+
+    if(FAILED(IDispatch_QueryInterface(disp, &IID_IHTMLElementCollection, (void**)&col)))
+        col = NULL;
+    IDispatch_Release(disp);
+    return col;
+}
+
