+
+/* Like MSXML's, the template is safe for scripting: web pages create it with
+ * new ActiveXObject("MSXML2.XSLTemplate.6.0") (Encarta 2009), and the HTML engine
+ * refuses objects without IObjectSafety. Same options as the DOM document. */
+static inline xsltemplate *impl_from_IObjectSafety( IObjectSafety *iface )
+{
+    return CONTAINING_RECORD(iface, xsltemplate, IObjectSafety_iface);
+}
 
+static HRESULT WINAPI xsltemplate_Safety_QueryInterface(IObjectSafety *iface, REFIID riid, void **ppv)
+{
+    xsltemplate *This = impl_from_IObjectSafety(iface);
+    return IXSLTemplate_QueryInterface(&This->IXSLTemplate_iface, riid, ppv);
+}
+
+static ULONG WINAPI xsltemplate_Safety_AddRef(IObjectSafety *iface)
+{
+    xsltemplate *This = impl_from_IObjectSafety(iface);
+    return IXSLTemplate_AddRef(&This->IXSLTemplate_iface);
+}
+
+static ULONG WINAPI xsltemplate_Safety_Release(IObjectSafety *iface)
+{
+    xsltemplate *This = impl_from_IObjectSafety(iface);
+    return IXSLTemplate_Release(&This->IXSLTemplate_iface);
+}
+
+#define SAFETY_SUPPORTED_OPTIONS (INTERFACESAFE_FOR_UNTRUSTED_CALLER|INTERFACESAFE_FOR_UNTRUSTED_DATA|INTERFACE_USES_SECURITY_MANAGER)
+
+static HRESULT WINAPI xsltemplate_Safety_GetInterfaceSafetyOptions(IObjectSafety *iface, REFIID riid,
+        DWORD *supported, DWORD *enabled)
+{
+    xsltemplate *This = impl_from_IObjectSafety(iface);
+
+    TRACE("(%p)->(%s %p %p)\n", This, debugstr_guid(riid), supported, enabled);
+
+    if(!supported || !enabled) return E_POINTER;
+
+    *supported = SAFETY_SUPPORTED_OPTIONS;
+    *enabled = This->safeopt;
+    return S_OK;
+}
+
+static HRESULT WINAPI xsltemplate_Safety_SetInterfaceSafetyOptions(IObjectSafety *iface, REFIID riid,
+        DWORD mask, DWORD enabled)
+{
+    xsltemplate *This = impl_from_IObjectSafety(iface);
+
+    TRACE("(%p)->(%s %lx %lx)\n", This, debugstr_guid(riid), mask, enabled);
+
+    if ((mask & ~SAFETY_SUPPORTED_OPTIONS) != 0)
+        return E_FAIL;
+
+    This->safeopt = (This->safeopt & ~mask) | (mask & enabled);
+    return S_OK;
+}
+
+#undef SAFETY_SUPPORTED_OPTIONS
+
+static const IObjectSafetyVtbl xsltemplateObjectSafetyVtbl = {
+    xsltemplate_Safety_QueryInterface,
+    xsltemplate_Safety_AddRef,
+    xsltemplate_Safety_Release,
+    xsltemplate_Safety_GetInterfaceSafetyOptions,
+    xsltemplate_Safety_SetInterfaceSafetyOptions
+};
+
